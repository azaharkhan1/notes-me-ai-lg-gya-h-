{
  "expo": {
    "name": "Notes AI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notesai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notesai.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to attach to your notes",
        "NSMicrophoneUsageDescription": "Record voice notes on your device",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to notes",
        "NSFaceIDUsageDescription": "Unlock your private notes with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.notesai.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to notes",
          "cameraPermission": "Take photos to attach to your notes"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private notes with Face ID"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8752E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF5E00"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
